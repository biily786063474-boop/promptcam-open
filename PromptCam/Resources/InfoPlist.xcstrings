{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "CFBundleDisplayName": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PromptCam Open"
          }
        }
      }
    },
    "CFBundleName": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PromptCam Open"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to record your talking-head videos."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to record the audio for your videos, and to hear which line you are reading so the teleprompter can scroll itself."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to recognize which line of your script you are reading so the teleprompter scrolls along. Recognition runs entirely on this device and no audio is ever uploaded."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to save your finished videos to Photos."
          }
        }
      }
    }
  },
  "version": "1.0"
}
