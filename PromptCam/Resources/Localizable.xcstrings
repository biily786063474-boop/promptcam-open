      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop Recording"
          }
        }
      }
    },
    "关掉后就是普通提词器,需要手动划动稿子。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn this off for a plain teleprompter you scroll by hand."
          }
        }
      }
    },
